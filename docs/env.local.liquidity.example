# Local dev — bot thanh khoản (tùy chọn, ghi vào backend/.env)
# Không set → mặc định 22 MM + 14 flow (prod: 12 + 4)

# MARKET_MAKER_BOT_COUNT=22
# MARKET_FLOW_BOT_COUNT=14
# MARKET_MAKER_ENABLED=true
# MARKET_FLOW_ENABLED=true

# Sau dev-up hoặc:
# cd backend && node scripts/ensure-liquidity-bots.js && node scripts/ensure-bot-inventory.js
