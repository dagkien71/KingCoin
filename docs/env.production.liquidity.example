# Gợi ý biến môi trường Render (production) — thanh khoản dày
# Copy vào Environment trên Render dashboard (backend service).

MARKET_MAKER_ENABLED=true
MARKET_FLOW_ENABLED=true

MARKET_MAKER_BOT_COUNT=12
MARKET_FLOW_BOT_COUNT=4

MARKET_MAKER_LEVELS=10
MARKET_MAKER_SPREAD_STEP=0.002
# Khối lượng mỗi bậc (token base) — tăng nếu sổ vẫn mỏng
MARKET_MAKER_QTY=350
MARKET_MAKER_INTERVAL_MS=800
MARKET_MAKER_MULTI_MID_STEP=0.35

MARKET_FLOW_INTERVAL_MS=700
MARKET_FLOW_QTY=48

MARKET_MAKER_SEED_BALANCE=500000000
MARKET_MAKER_BASE_BALANCE=8000000

# Sau deploy: bootstrap gọi ensure-liquidity-bots.js
# Hoặc shell: cd backend && node scripts/ensure-liquidity-bots.js && node scripts/ensure-bot-inventory.js
