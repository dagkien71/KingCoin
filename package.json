{
  "name": "kingcoin",
  "private": true,
  "description": "KingCoin monorepo — frontend + backend",
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "start:backend": "bash scripts/start-backend-dev.sh",
    "start:all": "concurrently -k -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run dev --prefix frontend\"",
    "dev:all": "npm run dev:up && npm run start:all",
    "start": "npm run start:all",
    "dev": "npm run dev:all",
    "graphify:update": "graphify update .",
    "reset:market": "npm run reset:market --prefix backend",
    "test:futures-flow": "npm run test:futures-flow --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
